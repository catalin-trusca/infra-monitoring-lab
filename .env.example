# Copy to .env and fill in: cp .env.example .env && chmod 600 .env
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-string
# 127.0.0.1 = reachable only through an SSH tunnel (recommended)
# 0.0.0.0   = public; also run host/03-firewall.sh with GRAFANA_PUBLIC=1
GRAFANA_BIND=127.0.0.1
GRAFANA_ROOT_URL=http://localhost:3000

# Alertmanager -> Telegram (create a bot with @BotFather, get chat id via @userinfobot)
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=123456789
