[Unit]
Description=Monitoring stack (Prometheus, Grafana, Loki, Alertmanager)
Documentation=file:///opt/monitoring-lab/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/monitoring-lab
ExecStartPre=/opt/monitoring-lab/scripts/render-alertmanager.sh
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/opt/monitoring-lab/scripts/render-alertmanager.sh
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
